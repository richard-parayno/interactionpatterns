---
import "../styles/fonts.css";
import "../styles/global.css";
// Preloaded so the first paint is already in Archivo; the mono face is only
// used by code samples and loads when one is on the page.
import sansFont from "../assets/fonts/archivo/Archivo-Variable-Latin.woff2?url";

interface Props {
  /** Page title; omit on the home page. */
  title?: string;
  description: string;
  /**
   * Makes the page exactly one screen tall, in two equal columns, with the
   * content filling the height between header and footer. For pages whose
   * content scrolls inside them: the index (the drum) and a pattern page
   * (the window; PageGrid keeps its own column split).
   */
  fit?: boolean;
}

const { title, description, fit = false } = Astro.props;

const siteName = "Interaction Patterns";
const pageTitle = title ? `${title} — ${siteName}` : siteName;
const canonical = new URL(Astro.url.pathname, Astro.site);
const isHome = Astro.url.pathname === "/";
// The site name is the page heading on the home page only.
const SiteName = isHome ? "h1" : "div";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <link rel="preload" href={sansFont} as="font" type="font/woff2" crossorigin />
  </head>
  <body class:list={{ fit }}>
    <header class="grid">
      <SiteName>
        <a href="/" aria-current={isHome ? "page" : undefined}>interactionpatterns</a>
      </SiteName>
      {
        Astro.slots.has("intro") && (
          <p class="intro quiet">
            <slot name="intro" />
          </p>
        )
      }
    </header>
    <main>
      <slot />
    </main>
    <footer class="quiet">
      <slot name="footer">
        <p>Collected by <a href="https://richardparayno.com">Richard Parayno</a></p>
      </slot>
      <slot name="footer-end" />
    </footer>
  </body>
</html>

<style>
  header {
    row-gap: var(--space-2);
    margin-bottom: var(--section-gap);
  }

  .intro {
    max-width: 26rem;
  }

  footer {
    display: flex;
    justify-content: space-between;
    gap: var(--gutter);
    margin-top: var(--space-21);
  }

  @media (min-width: 50rem) {
    .intro {
      grid-column: 2 / -1;
    }

    .fit {
      --grid-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* Only with scripting, because without it the index is an ordinary list.
     A pattern page then has a short window on a page that scrolls. */
  @media (scripting: enabled) {
    .fit {
      display: flex;
      flex-direction: column;
      /* A height, not a minimum, so content that can shrink (the drum) gives
         way on short screens before the page starts to scroll. */
      height: 100svh;
    }

    .fit main {
      display: flex;
      flex: 1 1 0;
      flex-direction: column;
    }

    .fit header {
      margin-bottom: var(--space-5);
    }

    .fit footer {
      margin-top: var(--space-3);
    }
  }
</style>
