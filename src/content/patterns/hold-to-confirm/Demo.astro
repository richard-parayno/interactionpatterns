---
// Press and hold to confirm a destructive action; releasing early cancels.
---

<button type="button" class="hold" data-hold-confirm>
  <span class="fill" aria-hidden="true"></span>
  <span class="label" aria-live="polite">Hold to delete</span>
</button>

<style>
  .hold {
    --duration: 1200ms;

    position: relative;
    overflow: hidden;
    padding: 1rem 2rem;
    border: 0;
    background: #e8e8e8;
    color: #111;
    font: inherit;
    touch-action: none;
    user-select: none;
    cursor: pointer;
  }

  .fill {
    position: absolute;
    inset: 0;
    background: #ff4f00;
    transform: scaleX(0);
    transform-origin: left;
    /* Releasing drains the fill quickly */
    transition: transform 200ms ease-out;
  }

  .hold[data-state="holding"] .fill {
    transform: scaleX(1);
    transition: transform var(--duration) linear;
  }

  .hold[data-state="done"] .fill {
    transform: scaleX(1);
    transition: none;
  }

  .label {
    position: relative;
  }
</style>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>("[data-hold-confirm]")) {
    const label = button.querySelector(".label")!;
    const fill = button.querySelector(".fill")!;
    const idleText = label.textContent;

    const start = () => {
      if (button.dataset.state) return;
      button.dataset.state = "holding";
      label.textContent = "Keep holding";
    };

    const cancel = () => {
      if (button.dataset.state !== "holding") return;
      delete button.dataset.state;
      label.textContent = idleText;
    };

    // The fill finishing its slow transition is the confirmation
    fill.addEventListener("transitionend", () => {
      if (button.dataset.state !== "holding") return;
      button.dataset.state = "done";
      label.textContent = "Deleted";
      setTimeout(() => {
        delete button.dataset.state;
        label.textContent = idleText;
      }, 1500);
    });

    button.addEventListener("pointerdown", (event) => {
      button.setPointerCapture(event.pointerId);
      start();
    });
    button.addEventListener("pointerup", cancel);
    button.addEventListener("pointercancel", cancel);
    button.addEventListener("keydown", (event) => {
      if ((event.key === " " || event.key === "Enter") && !event.repeat) {
        event.preventDefault();
        start();
      }
    });
    button.addEventListener("keyup", (event) => {
      if (event.key === " " || event.key === "Enter") cancel();
    });
    button.addEventListener("blur", cancel);
  }
</script>
