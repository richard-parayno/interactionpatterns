---
// Faux product window: a product mock framed as a real macOS window, with
// the rim outside and the light edge inside that macOS draws.
//
// The window is the sample's own stylesheet; only the mock inside (a made-up
// task app in its own warm dark palette) is styled here. The mock is a
// picture: plain elements, no links or buttons, nothing that reacts.
import "./mac-window.css";

const lists = [
  { name: "Inbox", icon: "inbox", count: 4 },
  { name: "Today", icon: "today", count: 6, selected: true },
  { name: "Upcoming", icon: "upcoming" },
  { name: "Done", icon: "done" },
];

const projects = [
  { name: "Website", tone: "amber" },
  { name: "Mobile app", tone: "teal" },
  { name: "Billing", tone: "rose" },
];

const tasks = [
  { title: "Send Okafor the revised quote", project: "Billing", time: "09:30", done: true },
  { title: "Review the onboarding copy", project: "Website", time: "10:15", done: true },
  { title: "Ship invoice export", project: "Billing", time: "13:00" },
  { title: "Fix the flaky sign-in test on Android", project: "Mobile app", time: "14:30" },
  { title: "Draft release notes for 2.4", project: "Website", time: "16:00" },
  { title: "Plan the next sprint", project: "Website", time: "17:00" },
];

const icons: Record<string, string> = {
  inbox: "M2.5 9.5 4.3 3.5h7.4l1.8 6v3h-11zm0 0h3.2a2.3 2.3 0 0 0 4.6 0h3.2",
  today: "M4.5 3.5h7a2 2 0 0 1 2 2v6a2 2 0 0 1-2 2h-7a2 2 0 0 1-2-2v-6a2 2 0 0 1 2-2zm-2 3h11m-8-4.5v3m5-3v3",
  upcoming: "M8 2.5a5.5 5.5 0 1 1 0 11 5.5 5.5 0 0 1 0-11zM8 5v3.2l2 1.3",
  done: "M8 2.5a5.5 5.5 0 1 1 0 11 5.5 5.5 0 0 1 0-11zM5.6 8.2l1.7 1.7 3.2-3.6",
};
---

<div
  class="mac-window demo"
  role="img"
  aria-label="A task app in a macOS window: a sidebar of lists and projects beside today's six tasks, two of them done."
>
  <div class="mac-window-frame" data-appearance="dark">
    <div class="mac-bar">
      <span class="mac-lights"><i></i><i></i><i></i></span>
      <span class="mac-title">Slate</span>
    </div>

    <div class="mac-body">
      <div class="app">
        <div class="side">
          {
            lists.map((list) => (
              <div class:list={["row", { selected: list.selected }]}>
                <svg viewBox="0 0 16 16" width="16" height="16">
                  <path d={icons[list.icon]} />
                </svg>
                <span class="name">{list.name}</span>
                {list.count && <span class="count">{list.count}</span>}
              </div>
            ))
          }

          <div class="group">Projects</div>
          {
            projects.map((project) => (
              <div class="row">
                <span class:list={["dot", project.tone]} />
                <span class="name">{project.name}</span>
              </div>
            ))
          }
        </div>

        <div class="main">
          <div class="head">
            <span class="heading">Today</span>
            <span class="date">Tue 10 Nov</span>
          </div>

          {
            tasks.map((task) => (
              <div class:list={["task", { done: task.done }]}>
                <svg class="check" viewBox="0 0 16 16" width="16" height="16">
                  <circle cx="8" cy="8" r="6.25" />
                  {task.done && <path d="M5.4 8.3l1.8 1.8 3.4-3.9" />}
                </svg>
                <span class="name">{task.title}</span>
                <span class="project">{task.project}</span>
                <span class="time">{task.time}</span>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  /* The stage centres its content, so the window is told how wide to be. */
  .demo {
    width: 100%;
    max-width: 40rem;
  }

  /* Everything below is the mock: the product's own colours, not macOS's. */
  .app {
    --ink: #ede8e0;
    --muted: #9c958b;
    --line: rgb(255 255 255 / 0.07);
    --accent: #e0a458;

    display: grid;
    grid-template-columns: 168px minmax(0, 1fr);
    background: #1d1b18;
    color: var(--ink);
  }

  .side {
    padding: 10px 8px 12px;
    background: #252320;
    box-shadow: inset -1px 0 0 var(--line);
  }

  .row {
    display: flex;
    align-items: center;
    gap: 8px;
    height: 28px;
    padding: 0 8px;
    border-radius: 6px;
  }

  .row.selected {
    background: rgb(255 255 255 / 0.08);
  }

  .row svg {
    flex: none;
    fill: none;
    stroke: var(--muted);
    stroke-width: 1.25;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .row.selected svg {
    stroke: var(--ink);
  }

  .name {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .count,
  .date,
  .project,
  .time {
    flex: none;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }

  .group {
    margin-top: 12px;
    padding: 0 8px;
    color: var(--muted);
    font-size: 11px;
    font-weight: 600;
    line-height: 24px;
  }

  .dot {
    flex: none;
    width: 8px;
    height: 8px;
    margin: 0 4px;
    border-radius: 2px;
  }

  .dot.amber {
    background: #e0a458;
  }

  .dot.teal {
    background: #7fb7a4;
  }

  .dot.rose {
    background: #d98a8a;
  }

  .main {
    padding: 10px 16px 12px;
  }

  .head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    height: 28px;
    margin-bottom: 4px;
  }

  .heading {
    font-size: 15px;
    font-weight: 600;
    line-height: 28px;
  }

  .task {
    display: flex;
    align-items: center;
    gap: 10px;
    height: 32px;
    box-shadow: inset 0 1px 0 var(--line);
  }

  .check {
    flex: none;
    fill: none;
    stroke: var(--muted);
    stroke-width: 1.25;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .task.done .check circle {
    fill: var(--accent);
    stroke: var(--accent);
  }

  .task.done .check path {
    stroke: #1d1b18;
    stroke-width: 1.5;
  }

  .task.done .name {
    color: var(--muted);
  }

  .time {
    width: 38px;
    text-align: right;
  }

  /* The same query that scales the window drops the sidebar and the project
     column, so a phone shows one pane with every label still on one line. */
  @container mac-window (max-width: 560px) {
    .app {
      grid-template-columns: minmax(0, 1fr);
    }

    .side,
    .project {
      display: none;
    }
  }
</style>
