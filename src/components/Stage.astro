---
// The surface a live demo runs on: a white panel, with the demo centred and
// keeping its own casing. In a flush <WindowView> it fills the window.
---

<div class="stage">
  <slot />
</div>

<style>
  .stage {
    /* Fixed-position demo UI stays inside the frame. */
    contain: layout;
    display: grid;
    place-items: center;
    min-height: max(22rem, 100%);
    padding: var(--space-5) var(--space-3);
    background: var(--panel);
    font-size: 1rem;
    text-transform: none;
  }
</style>
