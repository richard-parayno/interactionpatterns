---
// A pattern's screenshot, unframed: as wide as its column, but never so tall
// that it pushes everything after it out of the window.
import { Image } from "astro:assets";

interface Props {
  src: ImageMetadata;
  alt: string;
}

const { src, alt } = Astro.props;
---

<Image
  class="shot"
  {src}
  {alt}
  widths={[640, 960, 1280]}
  sizes="(min-width: 50rem) min(40rem, 60vw), 90vw"
  loading="eager"
/>

<style>
  .shot {
    width: auto;
    max-height: 22rem;
  }
</style>
