---
// A macOS window: traffic lights, a title bar, and the two borders macOS
// draws (a dark rim outside, a light edge inside). Only the chrome is macOS;
// what is inside keeps the site's own look. It holds everything a pattern
// page has to show, one <WindowView> at a time; <WindowNav> switches views.
//
// The window takes the height its parent gives it and never less than its
// minimum, and long views scroll inside it. The chrome is a picture: the
// lights do nothing. The title is the page's <h1>, because it is the one
// place the pattern's name shows in every view.
interface Props {
  /** Shown in the title bar, in the casing given. */
  title: string;
}

const { title } = Astro.props;
---

<div class="window">
  <div class="bar">
    <span class="lights" aria-hidden="true"><i></i><i></i><i></i></span>
    <h1 class="title">{title}</h1>
  </div>
  <div class="views">
    <slot />
  </div>
</div>

<style>
  .window {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    min-height: 20rem;
    /* The views do not size the window: it would otherwise grow to fit the
       longest one instead of letting it scroll. */
    contain: size;
    border-radius: 12px;
    background: var(--panel);
    box-shadow:
      /* An opaque rim, so the edge reads the same whatever is behind it. */
      0 0 0 1px #b4b4b4,
      0 2px 4px rgb(0 0 0 / 0.06),
      0 24px 56px -20px rgb(0 0 0 / 0.3);
  }

  /* The light inner edge, drawn above the content. */
  .window::after {
    content: "";
    position: absolute;
    z-index: 5;
    inset: 0;
    border-radius: inherit;
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.7);
    pointer-events: none;
  }

  .bar {
    display: grid;
    flex: none;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    column-gap: 14px;
    min-height: 36px;
    padding: 0 14px;
    border-radius: 12px 12px 0 0;
    background: linear-gradient(#f6f6f6, #e4e4e4);
    box-shadow: inset 0 -1px 0 rgb(0 0 0 / 0.14);
    cursor: default;
    user-select: none;
  }

  .lights {
    display: flex;
    gap: 8px;
  }

  .lights i {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: #ff5f57;
    box-shadow: inset 0 0 0 0.5px rgb(0 0 0 / 0.2);
  }

  .lights i:nth-child(2) {
    background: #febc2e;
  }

  .lights i:nth-child(3) {
    background: #28c840;
  }

  /* The system face, as in a real title bar, not the site's. */
  .title {
    overflow: hidden;
    color: var(--quiet);
    font: 600 13px / 1.2 -apple-system, BlinkMacSystemFont, "Helvetica Neue", sans-serif;
    text-overflow: ellipsis;
    text-transform: none;
    white-space: nowrap;
  }

  .views {
    position: relative;
    flex: 1 1 0;
    min-height: 0;
    overflow: hidden;
    border-radius: 0 0 12px 12px;
  }
</style>
