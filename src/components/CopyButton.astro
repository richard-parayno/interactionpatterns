---
// Copies the text of another element. By default it reads as a text link:
// underlined, in the size of the text around it. With `icon` it is the usual
// two-sheets glyph, for the corner of a <CopyBlock>. Either way it says
// "copied" for a moment (the icon becomes a tick); if the clipboard is out of
// reach, the text is selected instead.
interface Props {
  /** id of the element whose text is copied. */
  target: string;
  /** The button's text, or its accessible name and tooltip with `icon`. */
  label?: string;
  icon?: boolean;
}

const { target, label = "Copy prompt", icon = false } = Astro.props;
---

<button
  type="button"
  class:list={{ icon }}
  data-copy-target={target}
  data-copy-label={label}
  title={icon ? label : undefined}
>
  {
    icon && (
      <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
        <g class="sheets">
          <rect x="5.5" y="5.5" width="8" height="8" rx="1.5" />
          <path d="M10.5 3.5v-.5a1.5 1.5 0 0 0-1.5-1.5H4A1.5 1.5 0 0 0 2.5 3v5A1.5 1.5 0 0 0 4 9.5h.5" />
        </g>
        <path class="tick" d="m3 8.5 3.25 3.25L13 5" />
      </svg>
    )
  }
  <span class:list={{ "visually-hidden": icon }} data-copy-text>{label}</span>
</button>
<span class="visually-hidden" role="status" data-copy-status={target}></span>

<script>
  const RESET_MS = 1800;
  const resetTimers = new WeakMap<HTMLButtonElement, number>();

  function selectText(element: HTMLElement) {
    const range = document.createRange();
    range.selectNodeContents(element);
    const selection = window.getSelection();
    selection?.removeAllRanges();
    selection?.addRange(range);
  }

  function show(button: HTMLButtonElement, state: "copied" | "selected", announcement: string) {
    const text = button.querySelector("[data-copy-text]");
    // Each button announces through its own status: two buttons can copy
    // the same text.
    const status = button.nextElementSibling;
    if (!text || !status?.matches("[data-copy-status]")) return;

    const label = state === "copied" ? "Copied" : "Selected";
    button.dataset.state = state;
    text.textContent = label;
    if (button.title) button.title = label;
    status.textContent = announcement;

    window.clearTimeout(resetTimers.get(button));
    resetTimers.set(
      button,
      window.setTimeout(() => {
        delete button.dataset.state;
        text.textContent = button.dataset.copyLabel ?? "";
        if (button.title) button.title = button.dataset.copyLabel ?? "";
        status.textContent = "";
      }, RESET_MS),
    );
  }

  document.addEventListener("click", async (event) => {
    if (!(event.target instanceof Element)) return;
    const button = event.target.closest<HTMLButtonElement>("button[data-copy-target]");
    const target = button && document.getElementById(button.dataset.copyTarget ?? "");
    if (!button || !target) return;

    try {
      await navigator.clipboard.writeText(target.textContent ?? "");
      show(button, "copied", "Copied");
    } catch {
      // No clipboard access (permissions, insecure origin): leave the text
      // selected so one keystroke finishes the job.
      selectText(target);
      show(button, "selected", "Could not copy. The text is selected; press Ctrl+C or Command+C.");
    }
  });
</script>

<style>
  button {
    position: relative;
    margin: 0;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
    -webkit-tap-highlight-color: transparent;
  }

  button[data-state] {
    color: var(--quiet);
  }

  /* The icon is 16px in a 32px target. */
  .icon {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: var(--radius);
    color: var(--quiet);
    text-decoration: none;
  }

  .icon:hover,
  .icon[data-state] {
    color: var(--ink);
  }

  svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.25;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .tick,
  [data-state="copied"] .sheets {
    visibility: hidden;
  }

  [data-state="copied"] .tick {
    visibility: visible;
  }
</style>
