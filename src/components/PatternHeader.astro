---
// Name and summary of a pattern, set small in the rail beside the window.
// The default slot holds the text links under them: <WindowNav> and the
// prompt's <CopyButton>.
interface Props {
  name: string;
  summary: string;
}

const { name, summary } = Astro.props;
---

<div class="header">
  <h1>{name}</h1>
  <p class="quiet">{summary}</p>
  <div class="links">
    <slot />
  </div>
</div>

<style>
  .header {
    max-width: 22rem;
  }

  .links {
    display: grid;
    justify-items: start;
    row-gap: var(--space-2);
    margin-top: var(--space-3);
  }

  @media (min-width: 50rem) {
    .links {
      row-gap: var(--space-3);
      margin-top: var(--space-5);
    }
  }
</style>
