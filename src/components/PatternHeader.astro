---
// What opens a pattern inside its <Window>: the name, the live demo where a
// screenshot would go, and the summary under it. The prompt follows.
// Put the demo in the slot, inside a <Stage>.
interface Props {
  name: string;
  summary: string;
}

const { name, summary } = Astro.props;
---

<div class="header">
  <!-- The window's title bar is the heading; this repeats it for the eye. -->
  <p class="name" aria-hidden="true">{name}</p>
  <slot />
  <p class="quiet">{summary}</p>
</div>

<style>
  .header {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    row-gap: var(--space-2);
    max-width: var(--measure);
    margin-bottom: var(--space-5);
  }

  .name {
    margin-bottom: var(--space-1);
    font-size: var(--text-large);
    line-height: var(--leading-large);
    letter-spacing: var(--tracking-large);
  }
</style>
