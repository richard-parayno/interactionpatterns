---
// What opens a pattern inside its <Window>: the name, the screenshot, and
// the summary under it. The prompt follows.
import Screenshot from "./Screenshot.astro";

interface Props {
  name: string;
  summary: string;
  screenshot: ImageMetadata;
  screenshotAlt: string;
}

const { name, summary, screenshot, screenshotAlt } = Astro.props;
---

<div class="header">
  <!-- The window's title bar is the heading; this repeats it for the eye. -->
  <p class="name" aria-hidden="true">{name}</p>
  <Screenshot src={screenshot} alt={screenshotAlt} />
  <p class="quiet">{summary}</p>
</div>

<style>
  .header {
    display: grid;
    justify-items: start;
    row-gap: var(--space-2);
    max-width: var(--measure);
    margin-bottom: var(--space-5);
  }

  .name {
    margin-bottom: var(--space-1);
    font-size: var(--text-large);
    line-height: var(--leading-large);
    letter-spacing: var(--tracking-large);
  }
</style>
