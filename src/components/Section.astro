---
// A labelled part of a pattern page (live demo, screenshot, code). The label
// is small and quiet; the space above it does the separating.
interface Props {
  label: string;
}

const { label } = Astro.props;
---

<section>
  <h2 class="quiet">{label}</h2>
  <slot />
</section>

<style>
  section {
    margin-top: var(--section-gap);
  }

  h2 {
    margin-bottom: var(--space-2);
  }
</style>
