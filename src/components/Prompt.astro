---
// The agent prompt, shown verbatim as reading text: a size up from the site's
// own text, in one column. Pair it with <CopyButton target={id} />.
interface Props {
  /** Element id the copy button targets. Not "prompt": that is the view's. */
  id?: string;
  /** The prompt exactly as it should be pasted. */
  text: string;
}

const { id = "prompt-text", text } = Astro.props;
---

<pre {id}>{text}</pre>

<style>
  pre {
    max-width: var(--measure);
    font-family: var(--font-sans);
    font-size: var(--text-medium);
    line-height: var(--leading-medium);
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
</style>
