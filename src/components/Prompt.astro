---
// The agent prompt, verbatim, in a <CopyBlock>: a grey well with a copy icon
// in its corner. Long lines wrap; nothing is cut off or scrolled sideways.
import CopyBlock from "./CopyBlock.astro";

interface Props {
  /** Element id the copy buttons target. */
  id?: string;
  /** The prompt exactly as it should be pasted. */
  text: string;
}

const { id = "prompt-text", text } = Astro.props;
---

<div class="prompt">
  <CopyBlock label="prompt" target={id} copyLabel="Copy prompt">
    <pre {id}>{text}</pre>
  </CopyBlock>
</div>

<style>
  .prompt {
    max-width: var(--measure);
  }

  pre {
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
</style>
