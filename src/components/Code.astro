---
// One sample file: its name, a copy button, and the code set directly on the
// ground with no box. Highlighting is tonal: comments and punctuation are
// quiet, everything else is ink.
import { Code as Highlighted } from "astro:components";
import type { ComponentProps } from "astro/types";
import CopyButton from "./CopyButton.astro";

interface Props {
  /** File name shown above the code. */
  name: string;
  lang: ComponentProps<typeof Highlighted>["lang"];
  code: string;
  /** Element id for the copy button; defaults to one derived from `name`. */
  id?: string;
}

const { name, lang, code } = Astro.props;
const id = Astro.props.id ?? `code-${name.toLowerCase().replace(/[^a-z0-9]+/g, "-")}`;
---

<figure>
  <figcaption>
    <span class="name quiet">{name}</span>
    <CopyButton target={id} label="Copy" variant="text" />
  </figcaption>
  <Highlighted {id} {code} {lang} theme="css-variables" />
</figure>

<style>
  figure {
    --astro-code-foreground: var(--ink);
    --astro-code-background: transparent;
    --astro-code-token-constant: var(--ink);
    --astro-code-token-string: var(--ink);
    --astro-code-token-string-expression: var(--ink);
    --astro-code-token-keyword: var(--ink);
    --astro-code-token-parameter: var(--ink);
    --astro-code-token-function: var(--ink);
    --astro-code-token-link: var(--ink);
    --astro-code-token-comment: var(--quiet);
    --astro-code-token-punctuation: var(--quiet);
  }

  figure + figure {
    margin-top: var(--space-8);
  }

  figcaption {
    display: flex;
    gap: var(--space-3);
    margin-bottom: var(--space-2);
  }

  /* File names are case-sensitive. */
  .name {
    text-transform: none;
  }

  figure :global(pre) {
    font-size: var(--text-code);
    line-height: 1.6;
    tab-size: 2;
  }
</style>
