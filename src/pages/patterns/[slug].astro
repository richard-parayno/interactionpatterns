---
import CodeTabs from "../../components/CodeTabs.astro";
import CopyButton from "../../components/CopyButton.astro";
import PageGrid from "../../components/PageGrid.astro";
import PatternHeader from "../../components/PatternHeader.astro";
import Prompt from "../../components/Prompt.astro";
import Stage from "../../components/Stage.astro";
import Window from "../../components/Window.astro";
import WindowNav from "../../components/WindowNav.astro";
import WindowView from "../../components/WindowView.astro";
import { getPatterns, type Pattern } from "../../data/patterns";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const patterns = await getPatterns();

  return patterns.map((pattern) => ({
    params: { slug: pattern.entry.id },
    props: { pattern },
  }));
}

interface Props {
  pattern: Pattern;
}

const { entry, prompt, Demo, code } = Astro.props.pattern;
const { name, summary } = entry.data;

// Each id is a view in the window and its address (#code). The views switch
// through CSS :target, so no other element on the page may use these ids.
const views = [
  { id: "description", label: "Description" },
  { id: "code", label: "Code sample" },
];
---

<BaseLayout fit title={name} description={summary}>
  <PageGrid>
    <Fragment slot="rail">
      <WindowNav {views} />
      <CopyButton target="prompt-text" />
    </Fragment>
    <Window title={name}>
      <WindowView id="description" label="Description" initial>
        <PatternHeader {name} {summary}>
          <Stage><Demo /></Stage>
        </PatternHeader>
        <Prompt text={prompt} />
      </WindowView>
      <WindowView id="code" label="Code sample">
        <CodeTabs files={code} />
      </WindowView>
    </Window>
  </PageGrid>
</BaseLayout>
