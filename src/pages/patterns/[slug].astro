---
import Code from "../../components/Code.astro";
import CopyButton from "../../components/CopyButton.astro";
import PageGrid from "../../components/PageGrid.astro";
import PatternHeader from "../../components/PatternHeader.astro";
import Prompt from "../../components/Prompt.astro";
import Screenshot from "../../components/Screenshot.astro";
import Section from "../../components/Section.astro";
import Stage from "../../components/Stage.astro";
import { getPatterns, type Pattern } from "../../data/patterns";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const patterns = await getPatterns();

  return patterns.map((pattern) => ({
    params: { slug: pattern.entry.id },
    props: { pattern },
  }));
}

interface Props {
  pattern: Pattern;
}

const { entry, prompt, Demo, code } = Astro.props.pattern;
const { name, summary, screenshot, screenshotAlt } = entry.data;
---

<BaseLayout title={name} description={summary}>
  <PageGrid>
    <PatternHeader slot="rail" name={name} summary={summary}>
      <CopyButton target="prompt" />
    </PatternHeader>
    <Prompt text={prompt} />
    <Section label="Live demo">
      <Stage><Demo /></Stage>
    </Section>
    <Section label="Screenshot">
      <Screenshot src={screenshot} alt={screenshotAlt} />
    </Section>
    <Section label="Code">
      {code.map((file) => <Code {...file} />)}
    </Section>
  </PageGrid>
</BaseLayout>
