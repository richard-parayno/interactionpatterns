---
import PatternList from "../components/PatternList.astro";
import { getPatterns } from "../data/patterns";
import BaseLayout from "../layouts/BaseLayout.astro";

const patterns = await getPatterns();
---

<BaseLayout description="Interaction design patterns worth reusing, each with a live demo, sample code, and a prompt for AI agents.">
  <Fragment slot="intro">
    Interaction patterns I like and expect to reuse. Each one comes with a prompt you can paste into an AI agent.
  </Fragment>
  <PatternList
    patterns={patterns.map(({ entry }) => ({
      href: `/patterns/${entry.id}/`,
      name: entry.data.name,
      summary: entry.data.summary,
      screenshot: entry.data.screenshot,
    }))}
  />
</BaseLayout>
