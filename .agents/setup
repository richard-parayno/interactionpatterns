#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."

step() { echo "==> $*"; }
timed() { local start=$SECONDS; "$@"; echo "    (${*:1:3}: $((SECONDS - start))s)"; }

# Use the Bun version pinned in package.json's packageManager field.
pinned_bun="$(node -p 'require("./package.json").packageManager.split("@")[1]')"
if [[ "$(bun --version 2>/dev/null || true)" != "$pinned_bun" ]]; then
  step "Installing Bun $pinned_bun"
  curl -fsSL https://bun.sh/install | bash -s "bun-v$pinned_bun"
  export PATH="$HOME/.bun/bin:$PATH"
fi

step "Toolchain: node $(node --version), bun $(bun --version)"

step "Installing JavaScript dependencies"
timed bun install --frozen-lockfile

step "Setup complete"
